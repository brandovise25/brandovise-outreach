# Local .env for the helper scripts (git-ignored; copy to .env and fill in; never commit real values).
# The server's own settings live in .env.prod.example.

# scripts/outreach.sh: the app on the server and its remote API token
OUTREACH_URL=https://outreach.example.com
API_TOKEN=

# scripts/deploy.sh: Easypanel deploy link of the compose service (secret token; leak guard: .gitleaks.toml)
DEPLOY_HOOK_URL=
